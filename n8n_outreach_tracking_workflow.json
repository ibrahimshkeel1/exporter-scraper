{
  "name": "ExportFlow - Outreach & Tracking",
  "description": "Outreach workflow: scheduled hourly -> read sheet -> filter pending -> send email -> wait 3 days -> check replies -> follow-up logic",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "unit": "hours",
        "value": 1
      },
      "id": "01a2b3c4-5d6e-7f8g-9h0i-1j2a3b4c5d6e",
      "name": "Schedule - Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "read",
        "spreadsheetId": "{{ $json.googleSheetId }}",
        "range": "Outreach!A2:H1000",
        "options": {}
      },
      "id": "02b3c4d5-6e7f-8g9h-0i1j-2k3a4b5c6d7e",
      "name": "Google Sheets - Read Pending Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [
        450,
        300
      ],
      "credentials": {
        "googleSheetsAccess": "google_sheets_service_account"
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "{{ $json.status }}",
              "operation": "equals",
              "value2": "pending"
            }
          ]
        }
      },
      "id": "03c4d5e6-7f8g-9h0i-1j2k-3l4a5b6c7d8e",
      "name": "Filter - Only Pending",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "outreach@exportflow.io",
        "toEmail": "={{ $json.email }}",
        "subject": "Exclusive B2B Opportunity - {{ $json.companyName }}",
        "emailType": "html",
        "htmlBody": "<h3>Hello {{ $json.contactName }},</h3>\n<p>We've identified {{ $json.companyName }} as a strategic buyer for premium Pakistani textile & apparel.</p>\n<p><strong>Why We're Reaching Out:</strong></p>\n<ul>\n<li>Premium quality products at competitive pricing</li>\n<li>Direct supplier relationship (no middleman)</li>\n<li>Bulk customization available</li>\n</ul>\n<p><a href='{{ $json.proofLink }}'>View Sample Products</a></p>\n<p>Would love to discuss a potential partnership!</p>\n<p>—<br>ExportFlow Sourcing Team</p>"
      },
      "id": "04d5e6f7-8g9h-0i1j-2k3l-4m5a6b7c8d9e",
      "name": "Send Email - Outreach",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        850,
        300
      ],
      "credentials": {
        "smtp": "smtp_credentials"
      }
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "update",
        "spreadsheetId": "{{ $json.googleSheetId }}",
        "range": "Outreach!F{{ $json.row }}",
        "values": "=[\"sent\"]"
      },
      "id": "05e6f7g8-9h0i-1j2k-3l4m-5n6a7b8c9d0e",
      "name": "Update - Mark As Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [
        1050,
        300
      ],
      "credentials": {
        "googleSheetsAccess": "google_sheets_service_account"
      }
    },
    {
      "parameters": {
        "unit": "hours",
        "value": 72
      },
      "id": "06f7g8h9-0i1j-2k3l-4m5n-6o7a8b9c0d1e",
      "name": "Wait - 3 Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "mailbox": "outreach@exportflow.io",
        "markAsRead": true,
        "options": {
          "includeResolved": false
        }
      },
      "id": "07g8h9i0-1j2k-3l4m-5n6o-7p8a9b0c1d2e",
      "name": "Check Email - Look For Replies",
      "type": "n8n-nodes-base.imapEmail",
      "typeVersion": 2,
      "position": [
        1450,
        300
      ],
      "credentials": {
        "imap": "imap_credentials"
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.headers.from }}",
              "operation": "contains",
              "value2": "{{ $json.email }}"
            }
          ]
        }
      },
      "id": "08h9i0j1-2k3l-4m5n-6o7p-8q9a0b1c2d3e",
      "name": "If - Reply Received",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1650,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "update",
        "spreadsheetId": "{{ $json.googleSheetId }}",
        "range": "Outreach!F{{ $json.row }}",
        "values": "=[\"replied\"]"
      },
      "id": "09i0j1k2-3l4m-5n6o-7p8q-9r0a1b2c3d4e",
      "name": "Update - Mark As Replied",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [
        1850,
        200
      ],
      "credentials": {
        "googleSheetsAccess": "google_sheets_service_account"
      }
    },
    {
      "parameters": {
        "fromEmail": "outreach@exportflow.io",
        "toEmail": "={{ $json.email }}",
        "subject": "Re: Exclusive B2B Opportunity - Follow-up",
        "emailType": "html",
        "htmlBody": "<p>Hi {{ $json.contactName }},</p>\n<p>Following up on our previous email about the partnership opportunity.</p>\n<p>We're opening limited exclusive supplier slots this month. Are you available for a quick call this week?</p>\n<p><a href='{{ $json.calendlyLink }}'>Schedule Here</a></p>\n<p>—<br>ExportFlow Team</p>"
      },
      "id": "0aj1k2l3-4m5n-6o7p-8q9r-0s1a2b3c4d5e",
      "name": "Send Email - Follow-up",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1850,
        400
      ],
      "credentials": {
        "smtp": "smtp_credentials"
      }
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "update",
        "spreadsheetId": "{{ $json.googleSheetId }}",
        "range": "Outreach!F{{ $json.row }}",
        "values": "=[\"followup_sent\"]"
      },
      "id": "0bk2l3m4-5n6o-7p8q-9r0s-1t2a3b4c5d6e",
      "name": "Update - Mark As Follow-up Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [
        2050,
        400
      ],
      "credentials": {
        "googleSheetsAccess": "google_sheets_service_account"
      }
    },
    {
      "parameters": {
        "chatId": "{{ $json.adminChatId }}",
        "text": "📊 **Outreach Summary**\n\n**Sent**: 50 emails\n**Replied**: 8\n**Reply Rate**: 16%\n**Follow-ups Sent**: 42\n\nTop performers: [{{ $json.topPerformer1 }}, {{ $json.topPerformer2 }}]"
      },
      "id": "0cl3m4n5-6o7p-8q9r-0s1t-2u3a4b5c6d7e",
      "name": "Telegram - Daily Report",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        2050,
        600
      ],
      "credentials": {
        "telegramApi": "telegram_api"
      }
    }
  ],
  "connections": {
    "Schedule - Every Hour": {
      "main": [
        [
          {
            "node": "Google Sheets - Read Pending Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Read Pending Leads": {
      "main": [
        [
          {
            "node": "Filter - Only Pending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter - Only Pending": {
      "main": [
        [
          {
            "node": "Send Email - Outreach",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email - Outreach": {
      "main": [
        [
          {
            "node": "Update - Mark As Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update - Mark As Sent": {
      "main": [
        [
          {
            "node": "Wait - 3 Days",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait - 3 Days": {
      "main": [
        [
          {
            "node": "Check Email - Look For Replies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Email - Look For Replies": {
      "main": [
        [
          {
            "node": "If - Reply Received",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If - Reply Received": {
      "main": [
        [
          {
            "node": "Update - Mark As Replied",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Email - Follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email - Follow-up": {
      "main": [
        [
          {
            "node": "Update - Mark As Follow-up Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update - Mark As Follow-up Sent": {
      "main": [
        [
          {
            "node": "Telegram - Daily Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
